+#ifndef Foam_GSSolveCounters_H
+#define Foam_GSSolveCounters_H
+
+#include "label.H"
+#include "word.H"
+
+namespace Foam
+{
+namespace gsCallCounters
+{
+
+struct SolveRecord;
+
+// Scope one model-level fvMatrix solve.
+class FvSolveScope
+{
+    SolveRecord* record_;
+    SolveRecord* previous_;
+
+public:
+    explicit FvSolveScope(const word& fieldName);
+    ~FvSolveScope();
+
+    FvSolveScope(const FvSolveScope&) = delete;
+    FvSolveScope& operator=(const FvSolveScope&) = delete;
+};
+
+// Scope one smoothSolver::solve(), including all of its smooth() calls.
+class SmoothSolveScope
+{
+    SolveRecord* record_;
+    SolveRecord* previous_;
+
+public:
+    explicit SmoothSolveScope(const word& fieldName);
+    ~SmoothSolveScope();
+
+    SmoothSolveScope(const SmoothSolveScope&) = delete;
+    SmoothSolveScope& operator=(const SmoothSolveScope&) = delete;
+};
+
+// Called at the actual smoother factory, constructor, and sweep entry points.
+void noteSmootherNew();
+void noteGsConstructor();
+void noteGsSmooth(label nSweeps);
+
+} // namespace gsCallCounters
+} // namespace Foam
+
+#endif

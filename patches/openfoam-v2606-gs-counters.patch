 #include "lduMatrix.H"
+#include "GSSolveCounters.H"
+#include "UPstream.H"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+namespace Foam
+{
+namespace gsCallCounters
+{
+
+struct SolveRecord
+{
+    std::uint64_t id = 0;
+    word fieldName;
+    std::uint64_t smoothSolverCalls = 0;
+    std::uint64_t smootherNew = 0;
+    std::uint64_t gsConstructors = 0;
+    std::uint64_t gsSmoothCalls = 0;
+    std::uint64_t gsSweeps = 0;
+};
+
+namespace
+{
+
+struct CounterState
+{
+    std::mutex mutex;
+    int rank = 0;
+    std::uint64_t fvSolves = 0;
+    std::uint64_t smoothSolverSolves = 0;
+    std::uint64_t smootherNew = 0;
+    std::uint64_t gsConstructors = 0;
+    std::uint64_t gsSmoothCalls = 0;
+    std::uint64_t gsSweeps = 0;
+    std::vector<SolveRecord> fvRecords;
+    std::vector<SolveRecord> smoothRecords;
+};
+
+CounterState& state();
+
+void printAtExit()
+{
+    CounterState& counters = state();
+    std::lock_guard<std::mutex> lock(counters.mutex);
+    std::sort
+    (
+        counters.fvRecords.begin(), counters.fvRecords.end(),
+        [](const SolveRecord& a, const SolveRecord& b) { return a.id < b.id; }
+    );
+    std::sort
+    (
+        counters.smoothRecords.begin(), counters.smoothRecords.end(),
+        [](const SolveRecord& a, const SolveRecord& b) { return a.id < b.id; }
+    );
+    std::fprintf
+    (
+        stderr,
+        "GS_COUNTERS_BEGIN rank=%d fvSolves=%llu smoothSolverSolves=%llu "
+        "smootherNew=%llu gsConstructors=%llu gsSmoothCalls=%llu "
+        "gsSweeps=%llu\n",
+        counters.rank,
+        static_cast<unsigned long long>(counters.fvSolves),
+        static_cast<unsigned long long>(counters.smoothSolverSolves),
+        static_cast<unsigned long long>(counters.smootherNew),
+        static_cast<unsigned long long>(counters.gsConstructors),
+        static_cast<unsigned long long>(counters.gsSmoothCalls),
+        static_cast<unsigned long long>(counters.gsSweeps)
+    );
+    for (const SolveRecord& record : counters.fvRecords)
+    {
+        std::fprintf
+        (
+            stderr,
+            "GS_COUNTERS_FV_SOLVE rank=%d id=%llu field=%s "
+            "smoothSolverCalls=%llu smootherNew=%llu gsConstructors=%llu "
+            "gsSmoothCalls=%llu gsSweeps=%llu\n",
+            counters.rank,
+            static_cast<unsigned long long>(record.id),
+            record.fieldName.c_str(),
+            static_cast<unsigned long long>(record.smoothSolverCalls),
+            static_cast<unsigned long long>(record.smootherNew),
+            static_cast<unsigned long long>(record.gsConstructors),
+            static_cast<unsigned long long>(record.gsSmoothCalls),
+            static_cast<unsigned long long>(record.gsSweeps)
+        );
+    }
+    for (const SolveRecord& record : counters.smoothRecords)
+    {
+        std::fprintf
+        (
+            stderr,
+            "GS_COUNTERS_SMOOTH_SOLVE rank=%d id=%llu field=%s "
+            "smootherNew=%llu gsConstructors=%llu gsSmoothCalls=%llu "
+            "gsSweeps=%llu\n",
+            counters.rank,
+            static_cast<unsigned long long>(record.id),
+            record.fieldName.c_str(),
+            static_cast<unsigned long long>(record.smootherNew),
+            static_cast<unsigned long long>(record.gsConstructors),
+            static_cast<unsigned long long>(record.gsSmoothCalls),
+            static_cast<unsigned long long>(record.gsSweeps)
+        );
+    }
+    std::fprintf(stderr, "GS_COUNTERS_END rank=%d\n", counters.rank);
+    std::fflush(stderr);
+}
+
+CounterState& state()
+{
+    static CounterState* counters = []()
+    {
+        CounterState* result = new CounterState;
+        result->rank = UPstream::myProcNo();
+        std::atexit(printAtExit);
+        return result;
+    }();
+    return *counters;
+}
+
+thread_local SolveRecord* currentFvSolve = nullptr;
+thread_local SolveRecord* currentSmoothSolve = nullptr;
+
+} // namespace
+
+FvSolveScope::FvSolveScope(const word& fieldName)
+:
+    record_(new SolveRecord),
+    previous_(currentFvSolve)
+{
+    record_->fieldName = fieldName;
+    CounterState& counters = state();
+    {
+        std::lock_guard<std::mutex> lock(counters.mutex);
+        record_->id = ++counters.fvSolves;
+    }
+    currentFvSolve = record_;
+}
+
+FvSolveScope::~FvSolveScope()
+{
+    currentFvSolve = previous_;
+    CounterState& counters = state();
+    {
+        std::lock_guard<std::mutex> lock(counters.mutex);
+        counters.fvRecords.push_back(*record_);
+    }
+    delete record_;
+}
+
+SmoothSolveScope::SmoothSolveScope(const word& fieldName)
+:
+    record_(new SolveRecord),
+    previous_(currentSmoothSolve)
+{
+    record_->fieldName = fieldName;
+    CounterState& counters = state();
+    {
+        std::lock_guard<std::mutex> lock(counters.mutex);
+        record_->id = ++counters.smoothSolverSolves;
+        if (currentFvSolve) ++currentFvSolve->smoothSolverCalls;
+    }
+    currentSmoothSolve = record_;
+}
+
+SmoothSolveScope::~SmoothSolveScope()
+{
+    currentSmoothSolve = previous_;
+    CounterState& counters = state();
+    {
+        std::lock_guard<std::mutex> lock(counters.mutex);
+        counters.smoothRecords.push_back(*record_);
+    }
+    delete record_;
+}
+
+void noteSmootherNew()
+{
+    CounterState& counters = state();
+    std::lock_guard<std::mutex> lock(counters.mutex);
+    ++counters.smootherNew;
+    if (currentFvSolve) ++currentFvSolve->smootherNew;
+    if (currentSmoothSolve) ++currentSmoothSolve->smootherNew;
+}
+
+void noteGsConstructor()
+{
+    CounterState& counters = state();
+    std::lock_guard<std::mutex> lock(counters.mutex);
+    ++counters.gsConstructors;
+    if (currentFvSolve) ++currentFvSolve->gsConstructors;
+    if (currentSmoothSolve) ++currentSmoothSolve->gsConstructors;
+}
+
+void noteGsSmooth(const label nSweeps)
+{
+    CounterState& counters = state();
+    const std::uint64_t sweeps = nSweeps > 0 ? nSweeps : 0;
+    std::lock_guard<std::mutex> lock(counters.mutex);
+    ++counters.gsSmoothCalls;
+    counters.gsSweeps += sweeps;
+    if (currentFvSolve)
+    {
+        ++currentFvSolve->gsSmoothCalls;
+        currentFvSolve->gsSweeps += sweeps;
+    }
+    if (currentSmoothSolve)
+    {
+        ++currentSmoothSolve->gsSmoothCalls;
+        currentSmoothSolve->gsSweeps += sweeps;
+    }
+}
+
+} // namespace gsCallCounters
+} // namespace Foam
 
